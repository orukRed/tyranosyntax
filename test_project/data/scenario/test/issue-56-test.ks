; issue-56 変数・マクロ・キャラの参照先表示 (Shift+F12) に対応
;
; 検証手順:
;   拡張を Extension Development Host で起動し、このファイルを開く。
;   各ケースに記載のカーソル位置で Shift+F12（または右クリック→「すべての参照を検索」）を実行する。
;   issue-56-test2.ks と合わせてクロスファイルの参照も確認すること。

; ====================================================================
; 事前定義: マクロ・キャラクター
; ====================================================================

; マクロ定義
@macro name="issue56_macro"
  テストマクロの内容[r]
@endmacro

; キャラクター定義（画像の実在は問わない）
[chara_new name="issue56_chara" storage="chara/akane/normal.png" jname="テストキャラ"]
[chara_face name="issue56_chara" face="happy" storage="chara/akane/happy.png"]

; ====================================================================
; ケース1: @macro 定義行の "issue56_macro" 上で Shift+F12
;
;   確認: このファイルのケース2・ケース1b の呼び出し行と
;         issue-56-test2.ks のケース1c の呼び出し行が参照一覧に出ること。
;         includeDeclaration=true 時はこの定義行自体も含まれること。
; ====================================================================

*start
; ↑ここに宣言がある場合の確認用ラベル

; ====================================================================
; ケース2: [issue56_macro] の "issue56_macro" 上で Shift+F12
;
;   確認: ケース1 と同じ参照一覧が出ること（呼び出し元からでも定義元からでも同結果）
; ====================================================================
[issue56_macro]

; ====================================================================
; ケース1b: 同ファイル内の 2 回目の呼び出し（参照一覧に含まれる行）
; ====================================================================
[issue56_macro]

; ====================================================================
; ケース3: [eval exp="f.issue56_hp = 100"] の "f.issue56_hp" 上で Shift+F12
;
;   確認: このファイルと issue-56-test2.ks 内のすべての f.issue56_hp 参照が並ぶこと。
; ====================================================================
[eval exp="f.issue56_hp = 100"]
[emb exp="f.issue56_hp"]
[if exp="f.issue56_hp >= 50"]
  体力は十分です。[r]
[endif]

; ====================================================================
; ケース4: "tf.issue56_temp" 上で Shift+F12
;
;   確認: tf 変数でも参照一覧が出ること（f 以外のスコープも動作すること）。
; ====================================================================
[eval exp="tf.issue56_temp = 0"]
[eval exp="tf.issue56_temp = tf.issue56_temp + 1"]

; ====================================================================
; ケース5: [chara_show name="issue56_chara"] の "issue56_chara" 上で Shift+F12
;
;   確認: chara_* タグで issue56_chara を参照している全行（このファイル＋test2.ks）が
;         参照一覧に表示されること。
; ====================================================================
[chara_show name="issue56_chara" layer="1" left=400 top=100 time=500]
[chara_mod  name="issue56_chara" face="happy"]
[chara_hide name="issue56_chara" time=300]

; ====================================================================
; ケース6: コメント行・プレーンテキスト行上で Shift+F12
;
;   確認: 以下のコメント行やプレーンテキスト行上ではシンボルが検出されず、
;         「参照が見つかりません」になること。
; ====================================================================
; これはコメントです。ここで Shift+F12 しても参照は出ない。
ただのテキスト行でも同様に何も出ないこと。[p]

[jump storage="test/issue-56-test2.ks" target="*start"]
