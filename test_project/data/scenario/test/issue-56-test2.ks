; issue-56 クロスファイル参照検証用（issue-56-test.ks の副ファイル）
;
; このファイル単体ではなく、issue-56-test.ks 側でシンボルを選択して Shift+F12 した際に
; このファイルの参照行も結果一覧に含まれることを確認するために使用する。

*start

; ====================================================================
; ケース1c: issue56_macro のクロスファイル呼び出し
;
;   確認: issue-56-test.ks の issue56_macro 上で Shift+F12 したとき
;         この行も参照一覧に出ること。
; ====================================================================
[issue56_macro]

; ====================================================================
; ケース3c: f.issue56_hp のクロスファイル参照
;
;   確認: issue-56-test.ks の f.issue56_hp 上で Shift+F12 したとき
;         この行も参照一覧に出ること。
; ====================================================================
[eval exp="f.issue56_hp = f.issue56_hp - 30"]
[emb exp="f.issue56_hp"]

; ====================================================================
; ケース5c: issue56_chara のクロスファイル参照
;
;   確認: issue-56-test.ks の issue56_chara 上で Shift+F12 したとき
;         この行も参照一覧に出ること。
; ====================================================================
[chara_show name="issue56_chara" layer="1" left=200 top=100 time=300]
[chara_hide name="issue56_chara" time=200]

[s]
